# Copy this file to ".env" (same folder, project root) and fill in real values.
# Never commit the real ".env" file - it's already covered by .gitignore.
#
# This currently only covers the database connection (application/config/
# database.env-ready.php reads these). Other hardcoded settings - e.g.
# application/config/telegram.php - should be migrated the same way as a
# follow-up once you confirm which fields it uses.

DB_HOST=127.0.0.1
DB_USERNAME=root
